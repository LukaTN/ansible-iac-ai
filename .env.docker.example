# Copy to .env.docker for the compose stack:  cp .env.docker.example .env.docker
#
# Then always pass it explicitly, because Compose needs it for both
# interpolation and the containers:
#
#     docker compose --env-file .env.docker up --build
#
# Separate from .env on purpose. .env targets a process running on the
# host, where the database and Redis are on localhost; inside compose they
# are reachable as `db` and `redis`, and docker-compose.yml injects those
# URLs itself. Keep host-only values out of here.
#
# For real deployments these values come from External Secrets + Vault
# (Phase 8), never from a file on disk.

# ── Runtime ──────────────────────────────────────────────────────
# Left at development on purpose. Anything else makes config.py force
# SESSION_COOKIE_SECURE and HSTS on, and the browser then refuses to send
# the session cookie over the plain-HTTP port this stack publishes. The
# `__Host-` cookie prefix deferred out of Phase 0 is blocked on the same
# thing, and both land when TLS terminates at the ingress.
APP_ENV=development
DEBUG=false
PORT=5000
API_PORT=5000

# Browser origins allowed to open a Socket.IO connection. Must include
# the host:port you actually open in the browser (Docker UI is :5000;
# Vite is :5173). Missing entries show up as "Reconnecting..." forever.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# ── Security (required) ──────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it invalidates every session and CSRF token.
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_token

# ── Database credentials (consumed by both Postgres and the app) ─
POSTGRES_DB=ansibleai
POSTGRES_USER=ansibleai
POSTGRES_PASSWORD=CHANGE_ME_app_password

# ── Playbook artifact store (MinIO) ──────────────────────────────
# These are both the MinIO root credentials and the app's S3 keys;
# docker-compose.yml wires them to S3_ACCESS_KEY / S3_SECRET_KEY. A real
# deployment issues a scoped service account limited to this one bucket
# instead of handing the app the root user.
MINIO_ROOT_USER=ansibleai
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
S3_BUCKET=ansibleai-playbooks
# Host ports for poking at the store while debugging; the app reaches it
# over the compose network and does not need either.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Accounts / registration ──────────────────────────────────────
REGISTRATION_MODE=open
REQUIRE_ADMIN_APPROVAL=false
# ALLOWED_EMAIL_DOMAINS=example.com

# Seeded by the `migrate` service on every `up`. The password policy is
# enforced here too, so a weak value is rejected rather than accepted.
BOOTSTRAP_ADMIN_EMAIL=admin@ansibleai.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_passphrase_min_12_chars

# ── Logging ──────────────────────────────────────────────────────
# json once a log shipper is in front of it (Loki, Phase 6); console is
# easier to read in `docker compose logs`.
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Agent LLM ────────────────────────────────────────────────────
# OLLAMA_BASE_URL is set by docker-compose.yml to reach the host daemon.
AGENT_LLM_PROVIDER=ollama
AGENT_MODEL=gemma3:12b
PLAYBOOK_MODEL=qwen2.5-coder:14b
PLAYBOOK_MAX_TOKENS=2500
# AGENT_MAX_ITERATIONS=3
# Ceiling for one LLM call. gunicorn's request timeout (600s) has to stay
# above the worst-case total across the repair loop.
# AGENT_REQUEST_TIMEOUT=300

# Use OpenRouter instead of the host's Ollama:
# AGENT_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# ── ansible-lint ─────────────────────────────────────────────────
# The image installs ansible-lint, so it runs in-process. Unlike on
# Windows, no WSL hop is involved. Set to "skip" to disable the lint half
# of the production gate.
ANSIBLE_LINT_MODE=native

# ── Agent worker (Celery) ────────────────────────────────────────
# Broker URL, result backend, and the redis-backed cancel/log/socket
# settings are all set by docker-compose.yml — they depend on service
# names, so they do not belong in a file that is also read on the host.
#
# How many generations one worker container runs at once. The real
# ceiling is what the model server can serve concurrently, not what this
# container can schedule, so raising it past Ollama's parallelism only
# queues requests one layer further down.
CELERY_WORKER_CONCURRENCY=2
# CELERY_LOG_LEVEL=info
# Recycle a child process after this many turns; bounds the memory a slow
# leak in the RAG stack can reach.
# CELERY_MAX_TASKS_PER_CHILD=50
# Soft limit raises inside the task so it can save a "timed out" note;
# hard limit kills it if that cleanup hangs. Must exceed
# AGENT_REQUEST_TIMEOUT * AGENT_MAX_ITERATIONS.
# CELERY_SOFT_TIME_LIMIT=1500
# CELERY_TIME_LIMIT=1620

# ── gunicorn ─────────────────────────────────────────────────────
# GUNICORN_WORKERS can now go above 1: Socket.IO has a Redis message
# queue, so a client connected to one worker still receives events
# published by another process. Sticky sessions are still required at the
# ingress, because a Socket.IO session's polling requests must reach the
# worker holding it.
# GUNICORN_WORKERS=1
# Drop to HTTP long-polling if gevent's greenlets misbehave on this host:
#   GUNICORN_WORKER_CLASS=gthread
#   GUNICORN_THREADS=100
#   SOCKETIO_ASYNC_MODE=threading

# ── Phase 6a observability ───────────────────────────────────────
# Prometheus + Grafana: docker-compose.observability.yml
# Langfuse:             deploy/observability/docker-compose.langfuse.yml
#
# Generate secrets (do not commit real values):
#   openssl rand -base64 32
#   openssl rand -hex 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_base64_32
SALT=CHANGE_ME_base64_32
ENCRYPTION_KEY=CHANGE_ME_hex_64_chars_openssl_rand_hex_32
LANGFUSE_DB_PASSWORD=CHANGE_ME_langfuse_db
LANGFUSE_REDIS_AUTH=CHANGE_ME_langfuse_redis
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
LANGFUSE_MINIO_USER=minio
LANGFUSE_MINIO_PASSWORD=CHANGE_ME_minio8chars

# After creating an org + project in the Langfuse UI, paste keys here.
# From api/worker containers use host.docker.internal (Langfuse is a
# separate compose project — langfuse-web is not on the app network).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_ENABLED=true

# ── Phase 5: Keycloak SSO (optional) ─────────────────────────────
# Default AUTH_MODE=local: password login, no Keycloak required.
# Hybrid / OIDC:  docker compose --env-file .env.docker --profile sso up
# See deploy/keycloak/README.md.
# AUTH_MODE=hybrid
# OIDC_CLIENT_SECRET=ansibleai-dev-oidc-secret
# OIDC_ISSUER=http://localhost:8080/realms/ansibleai
# OIDC_INTERNAL_BASE_URL=http://keycloak:8080
# OIDC_REDIRECT_URI=http://localhost:5000/api/auth/oidc/callback
# Members stay on the AnsibleAI login page (no Keycloak redirect).
# OIDC_BROWSER_REDIRECT=false
# AUTH_BREAK_GLASS_EMAILS=admin@ansibleai.local
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
# Local Keycloak has no SMTP. Keep false until you configure email in the realm.
# OIDC_REQUIRE_EMAIL_VERIFIED=false
# USER_DAILY_TOKEN_BUDGET=0

