---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ k8s_cluster_name | to_json }}
kubernetesVersion: v{{ kubernetes_version }}
controlPlaneEndpoint: {{ k8s_control_plane_endpoint | to_json }}
networking:
  podSubnet: {{ k8s_pod_subnet | to_json }}
  serviceSubnet: {{ k8s_service_subnet | to_json }}
apiServer:
  certSANs:
    - {{ ansible_host | to_json }}
    - {{ inventory_hostname | to_json }}
{% for san in k8s_api_server_cert_sans %}
    - {{ san | to_json }}
{% endfor %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host | to_json }}
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///var/run/containerd/containerd.sock
  kubeletExtraArgs:
    cgroup-driver: systemd
