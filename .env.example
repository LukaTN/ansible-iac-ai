# Copy to .env and adjust for your machine.

# ── Database (required) ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://ansibleai:ansibleai@localhost:5432/ansibleai

# ── Embeddings (TEI or Ollama /v1/embeddings) ────────────────────
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ── Ollama (embeddings + optional local LLM) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Agent LLM (reason / repair / respond nodes) ────────────────
# Provider: openrouter | ollama
AGENT_LLM_PROVIDER=openrouter
AGENT_MODEL=google/gemma-4-31b-it:free

# OpenRouter (required when AGENT_LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=http://localhost:5000
# OPENROUTER_APP_NAME=AnsibleAI
# AGENT_FALLBACK_MODELS=google/gemma-3-27b-it:free,qwen/qwen3-next-80b-a3b-instruct:free

# Local agent (set AGENT_LLM_PROVIDER=ollama instead)
#   ollama pull qwen2.5-coder:7b
# AGENT_MODEL=qwen2.5-coder:7b

# How long Ollama keeps weights resident after a call. The 5-minute default
# makes an idle user pay a full cold load on their next message. "-1" pins
# the model for the life of the Ollama process.
# OLLAMA_KEEP_ALIVE=30m

# ── Playbook YAML generation ─────────────────────────────────────
# Size the models to your VRAM FIRST, and only split planner/drafter if both
# fit in memory at the same time.
#
# A separate PLAYBOOK_MODEL only pays off when the planner and the drafter
# can stay loaded together. If they can't, Ollama evicts and reloads on every
# reason->draft->reason hop and the split costs far more than it saves. On a
# 6 GB card, gemma3:12b + qwen2.5-coder:14b measured 18-23 s of reloading per
# hop plus 4.9 tok/s from spilling to CPU; the single resident
# qwen2.5-coder:7b measured 18 tok/s.
PLAYBOOK_MODEL=qwen2.5-coder:7b

# Cap on one draft. Too low truncates long playbooks mid-YAML, and the repair
# loop cannot recover because every retry truncates at the same point.
PLAYBOOK_MAX_TOKENS=2500

# ── Background generation ────────────────────────────────────────
# A turn takes minutes, so POST /api/chat returns 202 and a Celery worker
# does the work. Eager mode runs the task inline in the web process
# instead, which is what keeps `python app.py` usable with no broker and
# no worker running. config.py refuses it outside development.
#
# To exercise the real path locally, start Redis, then:
#   CELERY_TASK_ALWAYS_EAGER=false
#   SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/1
#   CANCEL_BACKEND=redis
# and run the worker in a second terminal:
#   celery -A tasks worker --loglevel=info --pool=solo
# (--pool=solo on Windows: the default prefork pool needs fork(), which
# Windows does not have.)
# CELERY_TASK_ALWAYS_EAGER=true
# CELERY_BROKER_URL=redis://localhost:6379/2
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# CELERY_SOFT_TIME_LIMIT=1500
# CELERY_TIME_LIMIT=1620

# ── Cross-process state ──────────────────────────────────────────
# "memory" keeps this state inside one process, which is only correct
# while there is exactly one. Both must be "redis" outside development.
# CANCEL_BACKEND=memory
# LOG_STREAM_BACKEND=memory
# Carries Socket.IO emits between processes. Required as soon as the
# agent runs anywhere other than the web process.
# SOCKETIO_MESSAGE_QUEUE=

# ── Playbook artifacts ───────────────────────────────────────────
# "local" archives finished playbooks under output/. "s3" sends them to
# MinIO or any S3-compatible store, which is what makes them readable
# from a replica other than the one that generated them.
# ARTIFACT_BACKEND=local
# ARTIFACT_LOCAL_DIR=output
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=ansibleai-playbooks
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Agent loop ───────────────────────────────────────────────────
# Total draft attempts per request (1 initial + N repair passes).
# Each failed production gate (validator errors / ansible-lint
# violations / placeholders) triggers a CoT repair + redraft.
# AGENT_MAX_ITERATIONS=3

# Skip the planner LLM round-trip when keyword heuristics already determine
# intent, pivot and the search query (see agent/graph.py::_can_skip_planner).
# Set to 0 to always call the planner.
# AGENT_FAST_PLANNER=1

# ── Flask (optional) ─────────────────────────────────────────────
# FLASK_ENV=development
# FLASK_USE_RELOADER=1

# ── ansible-lint (optional; Windows needs WSL or Docker) ─────────
# auto = WSL on Windows, native on Linux/macOS (default)
# ANSIBLE_LINT_MODE=auto
# ANSIBLE_LINT_WSL_DISTRO=Ubuntu
# ANSIBLE_LINT_DOCKER_IMAGE=pipelinecomponents/ansible-lint:latest

# ── Phase 5: Keycloak SSO (optional) ─────────────────────────────
# Leave AUTH_MODE=local (default) unless Keycloak is running.
# AUTH_MODE=hybrid
# OIDC_ISSUER=http://localhost:8080/realms/ansibleai
# OIDC_CLIENT_ID=ansibleai-web
# OIDC_CLIENT_SECRET=ansibleai-dev-oidc-secret
# OIDC_REDIRECT_URI=http://localhost:5000/api/auth/oidc/callback
# Members type email+password on AnsibleAI (no Keycloak page).
# OIDC_BROWSER_REDIRECT=false
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me
# AUTH_BREAK_GLASS_EMAILS=admin@example.com
# USER_DAILY_TOKEN_BUDGET=0

