# Keep the build context small and free of secrets. Anything listed here
# is invisible to `docker build`, so a path that the image genuinely needs
# must NOT be added — notably docker/, backend/ (app + migrations +
# gunicorn.conf.py), alembic.ini, scripts/, and related Python packages.

# ── Secrets: never bake credentials into a layer ─────────────────
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key
secrets/

# ── VCS and CI metadata ──────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.pre-commit-config.yaml

# ── Editor / assistant state ─────────────────────────────────────
.cursor
.cursorignore
.cursorindexingignore
.vscode
.idea

# ── Python caches and local virtualenvs ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# ── Node: the frontend stage runs `npm ci` itself ────────────────
frontend/node_modules/
frontend/dist/
node_modules/

# ── Prebuilt SPA: the frontend stage produces this, so shipping a
#    stale local build would silently win over the fresh one ──────
static/dist/

# ── Generated runtime artifacts (volumes at runtime) ─────────────
# The vector index is a build artifact: rebuild with
# `python backend/rag/pipeline.py --build`. Committing or copying it
# would add hundreds of MB to every layer.
data/chromadb/
data/kb_versions/
data/rag_eval/
data/raw_html/
raw_html/
output/
reports/
report/
backups/

# ── Local logs and scratch ───────────────────────────────────────
*.log
*.ndjson
debug-*.log
boot.log
boot.err.log
.snapshot_path.tmp
.ansible/

# ── Docs, decks and other non-runtime files ──────────────────────
docs/
*.pptx
*.docx
*.pdf
README.md

# ── Tests: the runtime image does not need them. CI installs
#    requirements-dev.txt and runs them against the source tree ───
tests/
